# Copy to .env and fill in. .env is gitignored and must never be committed.

# LiteLLM / OpenAI-compatible router
OPENAI_API_BASE=http://host.docker.internal:4000/v1
OPENAI_API_KEY=

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=crajah
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_URI=

# Google Custom Search — the tool-registry search endpoint returns 503 without both
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
