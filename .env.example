# Copy to .env and fill in. .env is gitignored and must never be committed.

# LiteLLM / OpenAI-compatible router
OPENAI_API_BASE=http://host.docker.internal:4000/v1
OPENAI_API_KEY=

# --- Models -------------------------------------------------------------
# One canonical LLM and one canonical embedding model. Every service falls
# back to these same literals in code, so a deployment that sets nothing still
# runs a consistent pair — but setting them here is what keeps the whole system
# on one model when it changes.
#
# DEFAULT_LLM_MODEL is what an agent gets when its version declares no model,
# what the civilization engine reasons with, and what the kagent manifest names.
# RAG_MODEL is what post-graph-rag uses for entity and relationship extraction;
# it defaults to DEFAULT_LLM_MODEL and is separable because extraction is a
# different workload from conversation.
DEFAULT_LLM_MODEL=gemini-3.5-flash-lite
RAG_MODEL=gemini-3.5-flash-lite

# The embedding model is NOT interchangeable. Vectors already in the database
# were written in this model's geometry, so changing it makes every stored
# distance meaningless — a change here means reindexing, not a restart.
# RAG_EMBEDDING_DIM must match the vector(N) column the schema declares.
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIM=1536

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=crajah
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_URI=

# Web search.
#
# Search runs through the model router's grounding, not the Google Custom
# Search API: Google withdrew "search the entire web" from Programmable Search
# Engine for new engines on 20 January 2026 and ends it for existing ones on
# 1 January 2027, so that route cannot be set up any more and would not have
# lasted. Grounding needs no second vendor — the router already here serves the
# model, and the model does the searching.
#
# Empty turns web search off everywhere: no realm is seeded with the tool, and
# no agent is told it has one.
WEB_SEARCH_MODEL=gemini-3.5-flash-lite

# Grounding cites its sources as opaque vertexaisearch redirects. Following one
# costs a HEAD request and yields the URL the claim actually came from, which
# is the whole point of a citation. Set to 0 to keep the redirects.
WEB_SEARCH_RESOLVE_CITATIONS=1
